{
  "compilerOptions": {
    // File structure
    "rootDir": ".",
    "outDir": "./dist",

    // Target environment
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true, // allows 'import express from "express";'
    "forceConsistentCasingInFileNames": true,

    // Node types
    "types": ["node"],

    // Strictness
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    // Source maps & declarations
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Skip checking node_modules
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
